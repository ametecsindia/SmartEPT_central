# ============================================================
# SmartEPT Central - .gitignore
# ============================================================

# Logs
*.log*

# OS generated files
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
!.env.example
*.env.backup
*.env.production

# PHP / Laravel
.phpactor.json
.phpunit.result.cache
.phpunit.cache/
vendor/
storage/*.key
/storage/pail

# IDE / AI development tools
.codex/
.cursor/
.idea/
.nova/
.vscode/
.zed/

# Authentication / local tooling
auth.json

# Node / frontend
node_modules/
public/build/
public/fonts-manifest.dev.json
public/hot
public/storage/

# Laravel IDE Helper
_ide_helper.php

# Homestead
Homestead.json
Homestead.yaml

# ============================================================
# Temporary / development cleanup files
# ============================================================

_to_delete/

# ============================================================
# LICENCE SIGNING KEYS
# ============================================================
# OWNER OVERRIDE — Ejaz, 11-Aug-2026
#
# These licence signing keys are intentionally committed.
# Repository MUST remain PRIVATE.
#
# Do NOT add /keys/ to ignored files.
# Explicit exception protects this folder if broader ignore
# rules are introduced later.
# ============================================================

!/keys/
!/keys/**

